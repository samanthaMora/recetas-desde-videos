# Copia este archivo como .env y rellena la clave.
# Consigue una en https://platform.claude.com/ (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Opcionales
# CLAUDE_MODEL=claude-opus-5-5
# WHISPER_MODEL=small          # tiny | base | small | medium | large-v3 (más grande = más preciso y más lento)
# MAX_FRAMES=30                # fotogramas enviados a Claude por video
# MAX_VIDEO_SECONDS=1200
# YTDLP_COOKIES_FILE=cookies.txt   # Instagram/Facebook a veces exigen sesión iniciada
# CORS_ORIGINS=*
# WORKERS=2

# claude | local (modelo abierto en un Mac con Apple Silicon, ver app/local_llm.py)
RECIPE_ENGINE=claude
